{
 "compilerOptions": {
  "target": "ES2020",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "jsx": "react-jsx",
  "strict": false,
  "skipLibCheck": true,
  "allowJs": true,
  "noEmit": true,
  "types": [
   "vite/client"
  ]
 },
 "include": [
  "src",
  "../site-code/src"
 ],
 "exclude": [
  "../site-code/src/extensions.ts",
  "../site-code/src/**/*.extension.ts"
 ]
}